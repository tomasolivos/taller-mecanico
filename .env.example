# Variables de entorno para configuración del backend .NET Web API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__miconexion=server=.\\sqlexpress; Initial Catalog=TallerMecanicoDB; user id=sa; password=TU_PASSWORD; Encrypt=False
